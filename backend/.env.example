PORT=3030
MONG_URI=mongodb://127.0.0.1:27017/taskify
JWT_KEY=replace-with-a-long-random-secret
# Optional separate signing secret for OTP hashes; defaults to JWT_KEY.
OTP_SECRET=
# Gmail: enable 2-Step Verification and use a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=your-email@example.com
# Set RESEND_API_KEY for Cloudflare Worker production (Workers cannot open Gmail SMTP sockets).
RESEND_API_KEY=
# Verified sender address on Resend; defaults to SMTP_FROM when omitted.
EMAIL_FROM=onboarding@resend.dev
